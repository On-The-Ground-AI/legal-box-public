# OTG Legal Box — .gitignore

# ── Reference repos (cloned locally, not part of this repo) ────────────────
reference/

# ── Python ─────────────────────────────────────────────────────────────────
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
*.pyc
*.pyo
__pycache__/
*.egg-info/
dist/
build/
# electron-builder reads icons + entitlements from electron/build/ — keep tracked.
!electron/build/
.Python

# ── Node.js / Frontend ─────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ── Data (user-specific, never commit case files or database) ──────────────
# Anchored to the repo root so it doesn't also match landing/demo/data/,
# which holds committed demo sample documents, not real user data.
/data/
*.db
*.sqlite
*.sqlite3

# ── Environment / secrets ──────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
backend.log
frontend.log

# ── OS files ───────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── IDEs ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Build artifacts (PyInstaller + Electron) ──────────────────────────
backend-dist/
dist-electron/
.pyinstaller-work/

# ── Electron ──────────────────────────────────────────────────────────
electron/node_modules/

# ── Claude Code ───────────────────────────────────────────────────────
.claude/

# ── Temp files ─────────────────────────────────────────────────────────────
*.tmp
*.temp

# Build-time staged artifacts (downloaded by scripts/build-app.sh / CI)
backend/embedding_model/
electron/vendor/
